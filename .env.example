# Copier ce fichier en ".env" (il n'est pas versionné) puis remplir les valeurs.

# Clé secrète Django. En générer une avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True sur votre poste, False sur un serveur
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Mettre True uniquement si le site est servi en HTTPS
DJANGO_SECURE_COOKIES=False

# Base PostgreSQL (mettre DB_ENGINE=sqlite pour une démo sans PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=ged_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Taille maximale d'un document déposé, en Mo
GED_MAX_UPLOAD_MB=20
